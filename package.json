{
  "name": "tabloxide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "bindings": "cargo test -p tabloxide export_bindings",
    "lint": "pnpm --dir ui lint && cargo clippy --workspace --all-targets -- -D warnings",
    "typecheck": "pnpm --dir ui typecheck",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "test": "node --test scripts/*.test.mjs && pnpm --dir ui test && cargo test --workspace"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
